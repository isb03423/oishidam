# Docker Compose 설정
# 이 파일을 저장소 루트의 .env로 복사한 뒤 값을 입력한다.

# Docker PostgreSQL 연결
# 비밀번호를 새로 만들 때는 영문·숫자를 사용하면 Compose의 $ 보간을 피할 수 있다.
DB_PASSWORD=replace_with_random_database_password

# 인증 및 개인정보 암호화
# JWT_SECRET은 32바이트, PII_KEYS는 64바이트의 난수를 Base64로 인코딩한다.
JWT_SECRET=replace_with_base64_encoded_32_random_bytes
PII_KEYS=replace_with_base64_encoded_64_random_bytes

# 브라우저 접속 주소
# 외부에서 접속할 때는 서버 IP 또는 도메인을 입력한다. 끝에 /를 붙이지 않는다.
# 주소를 변경한 뒤에는 프런트엔드를 다시 빌드한다.
APP_URL=http://localhost

# 이메일 발송
# Gmail 주소와 Google 앱 비밀번호를 입력한다. 앱 비밀번호의 공백은 제거한다.
SMTP_USERNAME=
SMTP_PASSWORD=

# 카카오 로그인
# 카카오 개발자 콘솔에서 Client Secret을 활성화하고 Redirect URI를 등록한다.
KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ImageKit 이미지 업로드
IMAGEKIT_PRIVATE_KEY=

# 토스페이먼츠 결제 테스트
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
