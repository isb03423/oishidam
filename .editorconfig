root = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120
ij_continuation_indent_size = 8
ij_java_keep_line_breaks = true
ij_java_keep_blank_lines_in_code = 1
ij_java_keep_blank_lines_in_declarations = 1
ij_java_keep_blank_lines_before_rbrace = 1
ij_java_align_multiline_parameters = false
ij_java_align_multiline_parameters_in_calls = false
ij_java_align_multiline_record = false
ij_java_align_multiline_binary_operation = false
ij_java_align_multiline_parenthesized_expression = false
ij_java_method_parameters_wrap = chop_down_if_long
ij_java_method_parameters_new_line_after_left_paren = true
ij_java_method_parameters_right_paren_on_new_line = true
ij_java_call_parameters_wrap = chop_down_if_long
ij_java_call_parameters_new_line_after_left_paren = true
ij_java_call_parameters_right_paren_on_new_line = true
ij_java_record_components_wrap = split_into_lines
ij_java_new_line_after_lparen_in_record_header = true
ij_java_rparen_on_new_line_in_record_header = true
ij_java_field_annotation_wrap = split_into_lines
ij_java_blank_lines_around_field = 1
ij_java_blank_lines_around_field_with_annotations = 1
ij_java_while_on_new_line = false
