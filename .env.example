# Docker Compose 전용 설정. 이 파일을 루트 .env로 복사한 뒤 값을 변경한다.
# DB 비밀번호는 영문·숫자로 생성하면 Compose의 $ 보간 문제를 피할 수 있다.
DB_PASSWORD=replace_with_random_database_password
# 정확히 32바이트의 난수를 Base64로 인코딩한 값. README.md의 생성 명령 참고.
JWT_SECRET=replace_with_base64_encoded_32_random_bytes

# 브라우저에서 접속할 출처. 외부 접속 시 서버 IP 또는 도메인으로 변경한다.
# 끝에 /를 붙이지 않는다. 변경 후 frontend를 다시 빌드해야 한다.
# 공개 HTTPS 서버: APP_URL=https://oishidam.kro.kr (Caddy가 인증서 자동 발급·갱신)
APP_URL=http://localhost

# 외부 연동을 사용할 때만 입력
KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
IMAGEKIT_PRIVATE_KEY=
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
