# .env.local로 복사해 사용. VITE_ 변수는 공개되므로 비밀키 금지.
# 개발 모드 초기값. 개발 도구에서 선택한 값이 있으면 선택값 우선.
VITE_MOCK_ENABLED=false
# 화면 개발 도구는 기본 숨김. 필요한 경우 true로 설정하고 개발 서버 재시작.
VITE_DEVTOOLS_ENABLED=false
# 필요하면 접속할 백엔드 API 기본 주소로 변경.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_AI_API_BASE_URL=http://127.0.0.1:8000
