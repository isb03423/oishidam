# 로컬 PostgreSQL 연결
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oishidam
DB_USER=postgres
DB_PASSWORD=

# 인증 및 개인정보 암호화
# JWT_SECRET은 32바이트, PII_KEYS는 64바이트의 난수를 Base64로 인코딩한다.
JWT_SECRET=
PII_KEYS=

# 프런트엔드 및 AI 서비스 주소
FRONTEND_URL=http://localhost:5173
SUCCESS_REDIRECT=http://localhost:5173/oauth/callback
AI_SERVICE_URL=http://localhost:8000

# 이메일 발송
# Gmail 주소와 Google 앱 비밀번호를 입력한다. 앱 비밀번호의 공백은 제거한다.
SMTP_USERNAME=
SMTP_PASSWORD=

# 카카오 로그인
# 카카오 개발자 콘솔에서 Client Secret을 활성화하고 Redirect URI를 등록한다.
KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ImageKit 이미지 업로드
IMAGEKIT_PRIVATE_KEY=

# 토스페이먼츠 결제 테스트
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
