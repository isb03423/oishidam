# PowPowerShell에서 아래 코드를 실행하여 JWT_SECRET 생성
# $jwtKeyBytes = New-Object byte[] 32
# $jwtRng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $jwtRng.GetBytes($jwtKeyBytes)
# [Convert]::ToBase64String($jwtKeyBytes)
# $jwtRng.Dispose()
JWT_SECRET=생성한_무작위_서명키
FRONTEND_URL=http://localhost:5173
SUCCESS_REDIRECT=http://localhost:5173/oauth/callback
AI_SERVICE_URL=http://localhost:8000
# 카카오 개발자 콘솔에서 Client Secret 활성화 및 Redirect URI 등록 필요
KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ImageKit 서버 전용 비밀키
IMAGEKIT_PRIVATE_KEY=

# 토스페이먼츠 주문서형 결제 테스트 전용 키 쌍
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
